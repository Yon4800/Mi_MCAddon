{
  "name": "mi_addon",
  "version": "1.0.0",
  "description": "Minecraft Bedrock Addon with Script API",
  "main": "MiBP/scripts/main.js",
  "scripts": {
    "build": "node scripts/build_emojis.js && esbuild src/main.ts --bundle --outfile=MiBP/scripts/main.js --format=esm --external:@minecraft/server --external:@minecraft/server-ui",
    "watch": "esbuild src/main.ts --bundle --outfile=MiBP/scripts/main.js --format=esm --external:@minecraft/server --external:@minecraft/server-ui --watch",
    "deploy": "node scripts/deploy.js"
  },
  "devDependencies": {
    "@minecraft/server": "^*",
    "@minecraft/server-ui": "^*",
    "esbuild": "^*",
    "jimp": "^*",
    "typescript": "^*"
  },
  "dependencies": {
    "sharp": "^*"
  }
}